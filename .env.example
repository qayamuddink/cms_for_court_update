# Environment configuration for LiveLaw Legal Journalism Platform

# Backend Server
PORT=8080
ENV=development
RUN_MIGRATIONS=true


# Database (PostgreSQL)
POSTGRES_USER=livelaw
POSTGRES_PASSWORD=livelaw_secret
POSTGRES_DB=livelaw
DATABASE_URL=postgres://livelaw:livelaw_secret@localhost:5432/livelaw?sslmode=disable

# Object Storage (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=livelaw-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# CMS
CMS_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# JWT & Security (for Phase 2)
JWT_SECRET=dev-secret-super-long-key-for-livelaw-platform-signing-jwt-tokens

# Search Engine (Meilisearch - Phase 11)
MEILISEARCH_URL=http://localhost:7700
MEILI_MASTER_KEY=masterKey123
